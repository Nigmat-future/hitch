{
  "name": "pi-hitch",
  "version": "0.1.0",
  "description": "Connect the AI providers you already have on this machine to Pi and Oh My Pi, without copying secrets or hand-editing config files.",
  "author": "Nigmat Rahim",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nigmat-future/hitch.git"
  },
  "bugs": "https://github.com/Nigmat-future/hitch/issues",
  "homepage": "https://github.com/Nigmat-future/hitch#readme",
  "type": "module",
  "bin": {
    "hitch": "bin/hitch.js"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "image": "https://raw.githubusercontent.com/Nigmat-future/hitch/main/docs/panel.png"
  },
  "scripts": {
    "start": "node bin/hitch.js",
    "ui": "node bin/hitch.js ui",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "src",
    "extensions",
    "PRIVACY.md"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "oh-my-pi",
    "llm",
    "provider",
    "byok",
    "local-first",
    "privacy",
    "pi-extension"
  ],
  "license": "MIT"
}
